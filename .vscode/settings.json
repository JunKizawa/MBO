{
  "files.associations": {
    "*.bas": "vba",
    "*.cls": "vba",
    "*.frm": "vba"
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "files.encoding": "shiftjis",
  "files.autoGuessEncoding": true,
  "files.eol": "\r\n",
  "[vba]": {
    "editor.defaultFormatter": null
  }
}
